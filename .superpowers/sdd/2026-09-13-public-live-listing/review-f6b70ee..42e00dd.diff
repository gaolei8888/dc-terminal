     /// 造一屏「看起来随机」的内容：足够大、足够没有重复模式，让 gzip 压不
     /// 小——不需要真随机，一个简单的异或移位生成器就够。
     fn noisy_lines(rows: usize, cols: usize) -> Vec<Vec<ScreenSpan>> {
         let mut seed: u64 = 0x2545_F491_4F6C_DD1D;
         let mut next = move || {
             seed ^= seed << 13;
             seed ^= seed >> 7;
             seed ^= seed << 17;
             seed
         };

     // 一分钟内自己收掉，不然就是永远播着。见 `live.rs` 里 `sweep` 的注释。
     let sweeping = live.clone();
     tokio::spawn(async move {
         let mut tick = tokio::time::interval(Duration::from_secs(10));
         loop {
             tick.tick().await;
             sweeping.sweep(Instant::now());
         }

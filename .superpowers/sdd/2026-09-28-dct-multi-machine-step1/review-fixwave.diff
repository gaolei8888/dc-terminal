+/// 一次性随机数的字节数。
+pub const NONCE_LEN: usize = 32;
+
+pub type Nonce = [u8; NONCE_LEN];
+
+fn record(out: &mut Vec<u8>, m: &Member) {
+    field(out, &m.name);
+    field(out, &m.endpoint);
+    field(out, &m.sign_pub);

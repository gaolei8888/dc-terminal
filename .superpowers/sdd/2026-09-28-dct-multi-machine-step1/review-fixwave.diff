+        let r = renew_if_due(secrets, token, origin, endpoint, now, send);
+        match &r {
+            Renewal::NotDue => {}
+            Renewal::Renewed => self.last = Some((at, false)),
+            Renewal::Failed(_) => self.last = Some((at, true)),
+        }
+        Some(r)
+    }

+    #[test]
+    fn concurrent_creators_end_up_with_one_matching_pair() {
+        for _ in 0..20 {
+            let t = tempfile::tempdir().unwrap();
+            let dir = t.path().join("mesh");
+            let spawn = |seed: u8| {

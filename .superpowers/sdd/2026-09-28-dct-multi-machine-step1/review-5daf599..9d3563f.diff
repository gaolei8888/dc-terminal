+                            [n.get(); 32]
+                        })
+                        .map(|k| (k.sign_pub(), k.kx_pub()))
+                        .unwrap()
+                })
+            };
+            let (a, b) = (spawn(10), spawn(100));
+            let (a, b) = (a.join().unwrap(), b.join().unwrap());
+            assert_eq!(a, b);
+            let disk = Store::at(dir).load_or_create_keys(&|| [1; 32]).unwrap();
+            assert_eq!((disk.sign_pub(), disk.kx_pub()), a);
+        }

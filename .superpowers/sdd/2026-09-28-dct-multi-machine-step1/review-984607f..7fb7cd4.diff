-members = ["crates/dct-link", "crates/dct-page", "crates/dct-srv", "crates/dct-brain"]
+members = ["crates/dct-link", "crates/dct-page", "crates/dct-srv", "crates/dct-brain", "crates/dct-mesh"]
 
 [package]
 name = "dct"
 version = "0.2.18"
 edition = "2021"
 license = "MIT"
 
 [dependencies]
 anyhow = "1"
 base64 = "0.22"
 # 跟中转服务共用的信封。`dct` 和 `dct-srv` 谁也不依赖谁，共同依赖这个。
 dct-link = { path = "crates/dct-link" }
 # 手机端那一页网页。放在共享 crate 里是因为中转也要发同一份——见那边的注释。
 dct-page = { path = "crates/dct-page" }
 # 定档、执行票、签名核对。dct 和 dco 的安卓 App 共用，只写一份——见 crates/dct-brain 的模块说明。
 dct-brain = { path = "crates/dct-brain" }
+# 多机之间通过中转互相认识：机器 id、6 位核对码、机器钥匙、签过名的组名单。
+dct-mesh = { path = "crates/dct-mesh" }
 regex = "1"

+        field(&mut expected, "msg");
+        field(&mut expected, "c-from");
+        field(&mut expected, "laptop/dc-terminal");
+        field(&mut expected, "c-to");
+        field(&mut expected, "desktop/dc-terminal");
+        field(&mut expected, "hello");

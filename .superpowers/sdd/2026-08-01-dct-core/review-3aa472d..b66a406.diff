+        term.draw(|f| draw(f, &View::Board, &sessions, &mut st, "", "", false))
+            .unwrap();
+        // profile 选择弹窗
+        let profiles = vec!["claude".to_string(), "shell".to_string()];
+        term.draw(|f| {
+            draw(

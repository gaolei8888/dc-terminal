+            .create(plain.path(), "shell")
+            .expect("锁中毒之后 create() 应该还能正常工作，而不是永远失败");
+        assert_eq!(m.list().iter().find(|s| s.id == id).unwrap().id, id);
+    }
+
+    #[test]
+    fn tick_marks_idle_when_pattern_matches() {

+    fn bad_token_is_not_retryable_but_unreachable_is() {
+        assert!(ChannelError::Unreachable.worth_retrying());
+        assert!(!ChannelError::BadToken.worth_retrying());
+        assert!(!ChannelError::Malformed.worth_retrying());

+fn initial_phone_status(secrets: &Mutex<SecretStore>) -> PhoneStatus {
+    let has_token = recover(secrets.lock()).get(PHONE_TOKEN_KEY).is_some();
+    PhoneStatus {
+        state: if has_token {
+            PhoneState::WaitingForPairing
+        } else {
+            PhoneState::Off
+        },

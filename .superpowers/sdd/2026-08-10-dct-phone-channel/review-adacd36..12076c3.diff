+    /// Verifying 期间敲字符不能改动 buf——那次验证已经把当时的 buf 发出去
+    /// 了，改了只会让用户误以为下一次回车用的是新值。
+    #[test]
+    fn typing_during_verifying_is_frozen() {
+        let (mut app, _dir) = App::test_app();
+        app.view = View::Phone {

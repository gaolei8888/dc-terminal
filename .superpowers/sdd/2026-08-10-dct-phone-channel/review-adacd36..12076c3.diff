+        // 那条约定里记的话一致（「daemon 端已经知道用户语言（目前只有
+        // Lang::Zh）」）。用户真的看到这句话，通常是因为存了很久没用过的
+        // 令牌在这次重启时才发现已经失效——那本来就是个冷门路径。
+        let (state, bot) = phone_verify_token(&token, crate::i18n::Lang::Zh, &|t| {
+            Telegram::new(t).get_me()
+        });
+        let mut ph = recover(phone.lock());

+            // 两种输出都要量，跟上面 `EnterSecret`/`PickProject` 是同一个道理。
+            View::Phone {
+                status: crate::proto::PhoneStatus {
+                    state: crate::proto::PhoneState::Off,
+                    bot: None,
+                    owner: None,

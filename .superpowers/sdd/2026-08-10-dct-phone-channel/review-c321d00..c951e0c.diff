+            // `Broken`，退出，不再自己转下去。
+            Ok(b) if !b.cursor_advanced => {
+                record_terminal_error(bridge, phone, ChannelError::Malformed);
+                return false;
+            }
             Ok(_) => attempt = 0, // 还有积压,继续吃,不退避

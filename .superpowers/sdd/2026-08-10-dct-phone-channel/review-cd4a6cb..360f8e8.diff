 /// 把内部错误还原成给界面的码。`downcast` 拿不到码的，说明这条路径还没归类——
 /// 照抄原文走 `Internal`，界面原样显示。这样迁移可以一条一条来，不必等到
 /// 每一条都归好类才敢合并。
 fn to_code(e: anyhow::Error) -> ErrorCode {
     match e.downcast::<crate::proto::CodedError>() {
         Ok(c) => c.0,
         Err(e) => ErrorCode::Internal(e.to_string()),
     }
 }
 

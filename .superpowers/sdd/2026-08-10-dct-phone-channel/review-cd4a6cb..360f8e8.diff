+
+    /// 第一个发消息的人成为主人。
+    #[test]
+    fn the_first_person_to_message_becomes_the_owner() {
+        let b = Bridge::for_test();
+        assert_eq!(b.accept(&msg(111, "在吗")), Accepted::Paired(111));
+        assert_eq!(b.accept(&msg(111, "先跑完")), Accepted::FromOwner);

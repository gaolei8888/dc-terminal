+    let (tx, rx) = mpsc::channel();
+    std::thread::spawn(move || {
+        let _ = tx.send(b.complete_counted(&p));
+    });
+    match rx.recv_timeout(d) {
+        Ok(r) => r,
+        Err(_) => Err(LlmError::Timeout),
+    }
 }
 

+fn drain_banner_from(r: anyhow::Result<Response>) -> Option<crate::drain::Progress> {
+    match r {
+        Ok(Response::DrainProgress { progress, .. }) if !progress.waiting.is_empty() => {
+            Some(progress)
+        }
+        _ => None,
+    }

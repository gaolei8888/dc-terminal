+/// 等会话停下那一段是怎么结束的。
+#[derive(Debug, PartialEq, Eq)]
+enum DrainEnd {
+    /// 后台已经交给小进程（或者已经换掉了），该等新后台了。
+    Swapping,
+    /// 用户按了 Ctrl+C，后台已经回到正常。

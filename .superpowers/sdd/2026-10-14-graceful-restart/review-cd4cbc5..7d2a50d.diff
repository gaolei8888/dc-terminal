+///
+/// 处理函数里只做一次原子写，Unix 上是 async-signal-safe 的；Windows 上
+/// 系统在新线程里调它，同样只写这一个标志。
+pub fn catch_ctrl_c() -> &'static std::sync::atomic::AtomicBool {
+    ctrl_c::install();
+    &ctrl_c::PRESSED

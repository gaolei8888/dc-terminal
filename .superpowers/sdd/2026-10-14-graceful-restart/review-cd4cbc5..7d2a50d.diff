+                let states: std::collections::HashMap<u32, crate::session::SessionState> =
+                    mgr.list().into_iter().map(|s| (s.id, s.state)).collect();
+                let mut send = |id: u32, text: &str| {
+                    crate::bridge::submit_unchecked(&mgr, id, text).is_ok()
+                };

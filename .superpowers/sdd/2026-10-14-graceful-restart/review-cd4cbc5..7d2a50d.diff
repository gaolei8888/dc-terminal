+
+        let resp = r.call(Request::Drain {
+            wait_s: 5,
+            nudge_wait_s: 2,
+            initiator: None,
+        });
+        assert!(
+            matches!(resp, Response::DrainProgress { active: true, .. }),
+            "全空闲时排空也在进行：{resp:?}"

+                    eprintln!("{} 的会话重启后一直没准备好，没能叫它继续", n.dir);
+                    mgr.push_resume_skip(crate::proto::WarningCode::ResumeNoteDropped {
+                        dir: n.dir,
+                    });
+                }
+                if notes.is_empty() {
+                    return;
+                }
+                std::thread::sleep(tick);
+            }
+        });

+        d.step(t0, &st(&[(3, Idle)]));
+        // 屏幕还没来得及变忙
+        assert!(d
+            .step(t0 + Duration::from_millis(500), &st(&[(3, Idle)]))
+            .is_empty());
+        // 10 秒还没变忙，当它不打算写了，算完
+        assert!(finish(&d.step(t0 + Duration::from_secs(10), &st(&[(3, Idle)]))).is_some());
+    }

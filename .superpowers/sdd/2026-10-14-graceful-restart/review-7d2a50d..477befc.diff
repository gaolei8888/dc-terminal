+pub(crate) fn submit_once(
+    mgr: &crate::session::SessionManager,
+    id: u32,
+    text: &str,
+) -> crate::resume_notes::Sent {
+    if !text.is_empty() && mgr.send_input(id, text).is_err() {
+        return crate::resume_notes::Sent::No;

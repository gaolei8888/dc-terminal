     let mut w = 0;
     let mut out = String::new();
     for ch in s.chars() {
+        if ch.is_control() {
+            continue;
+        }
         let cw = char_width(ch);
         if w + cw > max {
             out.push('…');
             return out;
         }
         w += cw;
         out.push(ch);
     }
     out
 }

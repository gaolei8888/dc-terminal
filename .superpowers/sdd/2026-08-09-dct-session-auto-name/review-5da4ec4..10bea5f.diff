+///
+/// 模型很少老老实实只给名字：会加引号、会加句号、会多写一句解释。
+/// 洗不干净的话屏幕上就会出现「「修登录白屏」。」。洗完是空串表示
+/// 这次没拿到可用的答案，调用方走兜底。
+pub(crate) fn clean_name(raw: &str) -> String {
+    const QUOTES: [char; 12] = [
+        '"', '\'', '「', '」', '『', '』', '“', '”', '‘', '’', '《', '》',
+    ];
+    const TAIL: [char; 12] = [
+        '。', '．', '.', '，', ',', '！', '!', '？', '?', '；', ';', '、',
+    ];

+                    }
+                    // 否则是参数/中间字节，继续吃，直到吃到终止字节
+                    // 或者这段文本本身就在这里用完。
+                }
+            }
+            // 裸 Esc：什么都不产出，也没有后续字节要吃。
+        } else if !ch.is_control() {
+            let room = match cap {
+                Some(n) => out.chars().count() < n,
+                None => true,
+            };

+    //   「修登录白屏」这种带着里层引号的残留。合成一个字符集一次性从
+    //   结尾向里扫，才能把「引号叠标点」这种情况一次剥到底。
+    let line = line.trim_start_matches(|c: char| QUOTES.contains(&c) || c.is_whitespace());

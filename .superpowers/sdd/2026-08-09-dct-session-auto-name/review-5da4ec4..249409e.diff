+/// 这次没拿到可用的答案，调用方走兜底。
+pub(crate) fn clean_name(raw: &str) -> String {
+    const QUOTES: [char; 12] = [
+        '"', '\'', '「', '」', '『', '』', '“', '”', '‘', '’', '《', '》',
+    ];
+    const TAIL: [char; 12] = [
+        '。', '．', '.', '，', ',', '！', '!', '？', '?', '；', ';', '、',
+    ];
+
+    let line = raw
+        .lines()
+        .map(str::trim)
+        .find(|l| !l.is_empty())
+        .unwrap_or("");
+    // 前后两端剥的字符集**不对称**，这是故意的：
+    // - 开头只剥引号和空白，不剥 TAIL 标点——名字本来就可能拿标点开头
+    //   （`.NET 迁移`、`.env 权限` 都是这个工具的域里说得通的会话名），
+    //   把开头的 `.` 当噪音铲掉会把真实名字铲坏。
+    // - 结尾把引号、TAIL 标点、空白放进同一个字符集里一次性剥：模型常把
+    //   整句话包在引号里、句末再补一个句号，比如「修登录白屏」。如果结尾

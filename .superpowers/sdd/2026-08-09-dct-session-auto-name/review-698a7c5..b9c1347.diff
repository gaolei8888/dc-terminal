         + display_width(&id.to_string())      // id 本身
         + 1                                    // id 后面那个空格
         + 1                                    // 名字后面那个空格
         + display_width(status_word)
         + 1; // 状态词后面那个空格
-    budget.saturating_sub(overhead).max(MIN_TITLE_NAME_COLS)
+    budget.saturating_sub(overhead)

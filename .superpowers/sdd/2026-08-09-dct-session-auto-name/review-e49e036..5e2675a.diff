 /// 把 $HOME 缩成 ~，界面上路径太长会被裁掉。
 pub(crate) fn short_path(p: &str) -> String {
     match std::env::var("HOME") {
         Ok(h) if !h.is_empty() && p.starts_with(&h) => format!("~{}", &p[h.len()..]),
         _ => p.to_string(),
     }
 }
 

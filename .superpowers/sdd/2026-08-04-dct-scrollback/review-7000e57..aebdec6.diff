+fn state_of(v: crate::pty::ScrollView, mark: usize) -> ScrollState {
+    ScrollState {
+        agent_owns: v.agent_owns,
+        alt_screen: v.alt_screen,
+        max: v.max,
+        offset: v.offset,
+        new_lines: v.offset.saturating_sub(mark),
+    }
+}

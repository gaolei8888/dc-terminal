+        // 用户再滚一次，计数重新归零
+        let st = mgr.scroll(id, ScrollBy::Rows(1)).unwrap();
+        assert_eq!(st.new_lines, 0);
+    }
+
+    #[test]
+    fn scrolling_a_session_that_does_not_exist_says_so() {
+        let mgr = SessionManager::new();
+        assert!(mgr.scroll(999, ScrollBy::Rows(1)).is_err());
+    }

+        // 数字告诉用户"底下有你还没看过的东西"，屏幕内容本身根本不会变）。
+        // 所以这里不能像别处那样等屏幕文字出现，只能等 scroll.new_lines
+        // 本身涨到 5。
+        let deadline = Instant::now() + Duration::from_secs(5);
+        loop {
+            let st = mgr.screen(id).unwrap().scroll;

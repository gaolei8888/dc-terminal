+    pub fn scroll_by(&self, rows: i32) -> ScrollView {
+        let mut parser = self.parser.lock().unwrap_or_else(|e| e.into_inner());
+        // 顺序不能反：probe_max 会把偏移拨到顶当副作用（见它自己的文档），
+        // 先读 cur 再 probe_max，不然 cur 读到的永远是上一次探测剩下的

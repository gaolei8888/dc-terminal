+/// 一次滚轮/翻页该做什么。纯函数，好测。
+pub(crate) enum ScrollAction {
+    /// 转发给 agent，dct 自己不处理。
+    Forward,
+    /// dct 自己滚这么多行；正数往上（看历史），负数往下。
+    Scroll(i32),

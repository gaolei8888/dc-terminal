+/// 在守护进程侧是 `saturating_sub` 之后再钳到 `[0, max]`，结果跟
+/// `ScrollBy::Bottom` 完全一样，多一个分支只是多一处要测的东西。
+pub(crate) fn scroll_hint(st: &ScrollState, lang: Lang) -> Option<String> {

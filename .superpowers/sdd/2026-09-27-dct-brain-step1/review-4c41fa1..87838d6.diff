+/// 按钮上的字**至少**意味着哪一档。分句判断否定，避免「放弃草稿，直接发布」这类
+/// 多意图的标签被前半句的否定完全压低。每句开头的否定说不清本意，只有非否定句
+/// 才能撑起来。
+pub fn tier_for_label(label: &str) -> Tier {
+    let label = label.trim();
+    if label.is_empty() {
+        return Tier::Read;
+    }
+
+    let clauses = split_clauses(label);
+    if clauses.is_empty() {
+        return Tier::Read;
+    }
+
+    clauses
+        .iter()
+        .filter_map(|clause| {
+            if negated(clause) {
+                None
+            } else {
+                Some(score_clause(clause))
+            }
+        })
+        .max()
+        .unwrap_or(Tier::Read)
+}

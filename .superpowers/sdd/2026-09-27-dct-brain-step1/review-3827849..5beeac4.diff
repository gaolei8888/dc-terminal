 pub fn platform_enclave() -> Box<dyn SecureEnclave> {
     #[cfg(target_os = "macos")]
     {
         Box::new(mac::MacEnclave)
     }
     #[cfg(not(target_os = "macos"))]
     {
         Box::new(NoEnclave)
     }
 }

+
+    #[test]
+    fn shown_parse_rejects_duplicate_step_numbers() {
+        let mut v = edit_bio(true);
+        v["steps"][1]["n"] = json!(1);
+        assert!(Shown::parse("social:edit-bio", &v).is_err());
+    }

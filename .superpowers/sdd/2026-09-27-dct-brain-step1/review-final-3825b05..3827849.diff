+
+    #[test]
+    fn window_and_start_in_over_their_caps_are_rejected() {
+        let w = world();
+        approve(&w.dcv, &w.keys, &w.se, &w.approvals, "social:edit-bio", &[], 1000).unwrap();
+        *w.dcv.show.borrow_mut() = edit_bio(true);

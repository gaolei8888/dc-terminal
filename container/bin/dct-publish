#!/usr/bin/env python3
"""Prepare private static previews; publishing remains a student UI action."""
import argparse
import base64
import hashlib
import http.client
import json
import os
from pathlib import Path
import re
import stat
import sys
from urllib.parse import urlencode, urlsplit

ORIGIN = 'https://dataclue.cn'
ROOTS = [(Path('/home/dc/work'), 'legacy'), (Path('/home/dc/.dct/student-projects/work'), 'library')]
EXTENSIONS = set('html css js mjs json txt svg png jpg jpeg gif webp avif ico woff woff2 ttf otf wasm glb gltf bin mp3 mp4 webm ogg wav pdf'.split())
MAX_FILES, MAX_BYTES, MAX_RESPONSE = 5000, 100 * 1024**2, 1024**2
SENSITIVE = re.compile(r'(^\.env($|[.-])|^\.(npmrc|pypirc|netrc)$|^(credentials?|secrets?|id_rsa|id_ed25519)([.-]|$)|^(auth|publish|tokens?)\.json$|\.(pem|key|p12|pfx)$)', re.I)
SECRET = re.compile(rb'-----BEGIN [A-Z ]*PRIVATE KEY-----|\bsk-(?:proj-|ant-)?[A-Za-z0-9_-]{20,}|(?:api[_-]?key|access[_-]?token|client[_-]?secret|password|token)["\']?\s*[=:]\s*["\'][^"\'\r\n]{8,}["\']', re.I)

class PublishError(Exception): pass

def safe_directory(value):
    path = Path(os.path.abspath(os.path.expanduser(value)))
    for parent in [*reversed(path.parents), path]:
        if parent.is_symlink(): raise PublishError('发布目录不能经过符号链接。')
    path = path.resolve(strict=True)
    for root, namespace in ROOTS:
        if path == root or root in path.parents:
            relative = path.relative_to(root).as_posix()
            return path, hashlib.sha256((namespace + ':' + relative).encode()).hexdigest()
    raise PublishError('请选择自己工作区内的静态构建目录。')

def excluded(relative):
    parts = relative.parts
    name = parts[-1].lower()
    return (any(p.startswith('.') or p == 'node_modules' for p in parts)
            or name.endswith('.map') or re.fullmatch(r'package.*\.json', name)
            or re.match(r'(config|tsconfig)(?:\.|$)', name)
            or name in {'jsconfig.json', 'composer.json', 'deno.json'}
            or re.match(r'(vite|webpack|rollup|next|nuxt|svelte|postcss|tailwind)\.config\.', name))

def collect(root, root_fd=None):
    files, total, scanned, seen = [], 0, 0, set()
    rootfd = os.dup(root_fd) if root_fd is not None else os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        for directory, directories, names, dirfd in os.fwalk('.', dir_fd=rootfd, follow_symlinks=False):
            for name in sorted(directories + names):
                scanned += 1
                if scanned > 100000: raise PublishError('目录过大，请只选择构建后的静态文件目录。')
                info = os.stat(name, dir_fd=dirfd, follow_symlinks=False)
                relative = Path(directory) / name
                if SENSITIVE.search(name): raise PublishError('目录含凭据或敏感文件，请移除后再准备预览。')
                if stat.S_ISLNK(info.st_mode) or not (stat.S_ISDIR(info.st_mode) or stat.S_ISREG(info.st_mode)):
                    raise PublishError('目录含链接或特殊文件，请使用普通静态文件。')
                if stat.S_ISDIR(info.st_mode): continue
                if info.st_nlink != 1: raise PublishError('目录含硬链接，请使用独立的普通文件。')
                if excluded(relative): continue
                rendered = relative.as_posix()
                if (len(rendered.encode('utf-16-le')) // 2 > 512 or any(len(part.encode('utf-16-le')) // 2 > 200 for part in relative.parts)
                        or re.search(r'[\\\x00-\x1f\x7f?#%]', rendered)):
                    raise PublishError('静态文件路径含不支持的字符或过长，请修改文件名。')
                if rendered.lower() in seen: raise PublishError('静态文件存在大小写冲突，请修改文件名。')
                seen.add(rendered.lower())
                if relative.suffix.lower().lstrip('.') not in EXTENSIONS:
                    raise PublishError('目录含不支持的文件类型，请先构建为纯静态网站。')
                if len(files) >= MAX_FILES or total + info.st_size > MAX_BYTES:
                    raise PublishError('静态作品最多 5000 个文件、100 MiB。')
                fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=dirfd)
                with os.fdopen(fd, 'rb') as stream:
                    opened = os.fstat(stream.fileno())
                    if not stat.S_ISREG(opened.st_mode) or (opened.st_dev, opened.st_ino, opened.st_nlink) != (info.st_dev, info.st_ino, 1):
                        raise PublishError('文件正在变化，请构建完成后再试。')
                    data = stream.read(MAX_BYTES - total + 1)
                    after = os.fstat(stream.fileno())
                if (len(data) != info.st_size or after.st_mtime_ns != info.st_mtime_ns
                        or after.st_ctime_ns != info.st_ctime_ns):
                    raise PublishError('文件正在变化，请构建完成后再试。')
                if SECRET.search(data): raise PublishError('静态文件疑似包含凭据，请移除后再准备预览。')
                total += len(data)
                files.append({'path': relative.as_posix(), 'data': base64.b64encode(data).decode('ascii')})
    finally: os.close(rootfd)
    if not any(item['path'] == 'index.html' for item in files):
        raise PublishError('静态目录根部需要 index.html。')
    return sorted(files, key=lambda item: item['path']), total

def load_config(path=None):
    path = path or Path.home() / '.dct' / 'publish.json'
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, 'rb') as stream:
        info = os.fstat(stream.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or info.st_mode & 0o077:
            raise PublishError('工作区发布配置权限无效，请重新打开工作区。')
        raw = stream.read(4097)
    if len(raw) > 4096: raise PublishError('工作区发布配置无效。')
    config = json.loads(raw)
    if not isinstance(config, dict) or config.get('url') != ORIGIN or not re.fullmatch('[a-f0-9]{64}', str(config.get('token', ''))):
        raise PublishError('工作区发布配置无效，请重新打开工作区。')
    return config

def public_url(value, field):
    if not isinstance(value, str) or len(value) > 4096: return False
    try:
        parsed = urlsplit(value)
        if parsed.scheme != 'https' or parsed.port not in {None, 443} or parsed.username or parsed.password: return False
        if field == 'previewUrl':
            return parsed.hostname == 'works.dataclue.cn' and bool(re.fullmatch(r'/preview/[a-f0-9]{64}/index\.html', parsed.path)) and not parsed.query and not parsed.fragment
        if field == 'confirmUrl':
            return parsed.hostname == 'dataclue.cn' and bool(re.fullmatch(r'/w/(?:shared|[a-f0-9]{32})/', parsed.path)) and bool(re.fullmatch(r'publish=[a-f0-9]{32}', parsed.query)) and not parsed.fragment
        if field == 'projectUrl':
            return parsed.hostname == 'ai.tzspace.cn' and parsed.path == '/projects' and bool(parsed.fragment) and not parsed.query
        return False
    except ValueError: return False

def validate_result(result, preparing=False):
    if not isinstance(result, dict) or not isinstance(result.get('status'), str):
        raise PublishError('服务返回无效，操作结果未知；请在工作区检查状态，不要重复提交。')
    if preparing and (result.get('status') != 'prepared' or not isinstance(result.get('version'), str)
                      or not public_url(result.get('previewUrl'), 'previewUrl') or not public_url(result.get('confirmUrl'), 'confirmUrl')):
        raise PublishError('服务未返回有效预览和确认链接；请在工作区检查状态，不要重复提交。')
    for key, value in result.items():
        if key.lower().endswith('url') and value is not None and not public_url(value, key):
            raise PublishError('服务返回的链接无效；请在工作区检查状态。')
    return result

def request(config, method, path, payload=None):
    body = json.dumps(payload, ensure_ascii=False, separators=(',', ':')).encode() if payload is not None else None
    if body and len(body) > 145 * 1024**2: raise PublishError('上传请求过大，请减小静态作品。')
    connection = http.client.HTTPSConnection('dataclue.cn', timeout=120)
    try:
        connection.request(method, path, body=body, headers={'Authorization': 'Bearer ' + config['token'], 'Content-Type': 'application/json', 'Accept': 'application/json'})
        response = connection.getresponse()
        data = response.read(MAX_RESPONSE + 1)
        if response.status in {401, 403}: raise PublishError('发布权限已失效，请重新打开自己的工作区。')
        if not 200 <= response.status < 300 or len(data) > MAX_RESPONSE:
            raise PublishError('发布服务未完成请求；请在工作区检查状态，不要盲目重试。')
        return validate_result(json.loads(data), preparing=method == 'POST')
    except PublishError: raise
    except Exception:
        raise PublishError('连接中断或响应无效，操作结果未知；请在工作区检查状态，不要重复提交。') from None
    finally: connection.close()

def main():
    parser = argparse.ArgumentParser(description='准备静态作品预览，由学生在页面确认发布。')
    commands = parser.add_subparsers(dest='command', required=True)
    prepare = commands.add_parser('prepare')
    prepare.add_argument('--dir', required=True)
    prepare.add_argument('--title', required=True)
    prepare.add_argument('--summary', default='')
    status = commands.add_parser('status')
    status.add_argument('--version', required=True)
    args = parser.parse_args()
    config = load_config()
    if args.command == 'prepare':
        if not args.title.strip() or len(args.title.encode('utf-16-le')) // 2 > 100 or len(args.summary.encode('utf-16-le')) // 2 > 500:
            raise PublishError('请填写 1–100 字标题，简介不超过 500 字。')
        root, key = safe_directory(args.dir)
        files, _ = collect(root)
        result = request(config, 'POST', '/_agent/publish/prepare', {'projectKey': key, 'title': args.title.strip(), 'summary': args.summary, 'files': files})
    else:
        if not re.fullmatch('[A-Za-z0-9_-]{1,128}', args.version): raise PublishError('版本编号无效。')
        result = request(config, 'GET', '/_agent/publish/status?' + urlencode({'version': args.version}))
    print(json.dumps(result, ensure_ascii=False))

if __name__ == '__main__':
    try: main()
    except PublishError as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
    except Exception:
        print('无法准备发布，请检查静态目录及工作区发布配置。', file=sys.stderr)
        sys.exit(1)

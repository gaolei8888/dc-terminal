#!/usr/bin/env python3
"""Register DCT's shared publishing skill without overwriting user skills."""
import os
from pathlib import Path
import sys


def install(source, home):
    skill = source.resolve() / "ai-pub"
    if not (skill / "SKILL.md").is_file():
        raise ValueError(f"Missing skill: {skill}")
    # DC uses Qwen Code; Codex uses the shared Agent Skills directory.
    for directory in (".agents/skills", ".claude/skills", ".qwen/skills"):
        legacy = home / directory / "ai-tzspace-publish"
        if legacy.is_symlink() and legacy.resolve() == source.resolve() / "ai-tzspace-publish":
            legacy.unlink()
        destination = home / directory / skill.name
        destination.parent.mkdir(parents=True, exist_ok=True)
        if os.path.lexists(destination):
            if destination.resolve() != skill:
                print(f"Preserved existing skill: {destination}", file=sys.stderr)
            continue
        destination.symlink_to(skill, target_is_directory=True)


if __name__ == "__main__":
    install(Path(sys.argv[1] if len(sys.argv) > 1 else "/usr/local/share/dct-skills"), Path.home())

[Unit]
Description=DC classroom administrator and workspace gateway
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/opt/dc-terminal/classroom
ExecStart=/opt/dc-terminal/classroom/node /opt/dc-terminal/classroom/server.mjs
Environment=CLASSROOM_STATE=/var/lib/dcw-classroom
Environment=CLASSROOM_ORIGIN=https://dataclue.cn
Environment=CLASSROOM_LEGACY_CONTAINER=dcw-workspace-1
Environment=CLASSROOM_IMAGE=dc-workspace:0.2.14-classroom
Restart=on-failure
RestartSec=3
MemoryMax=256M
TasksMax=128
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0077

[Install]
WantedBy=multi-user.target
